# ============================================================
# Applied Statistical Analysis
# Data Cleaning, Descriptive Analysis, and Logistic Regression
# ============================================================

# Load packages
library(tidyverse)
library(broom)
# ------------------------------------------------------------
# 1. Import data
# ------------------------------------------------------------

# Import analytic dataset
# Original data are not included in this public repository.
# Replace the file path below with the location of the analytic dataset.

clinical_data <- read.csv("clinical_data.csv")

# Create working analysis dataset
analysis_data <- clinical_data

# Inspect dataset structure
glimpse(analysis_data)


# ------------------------------------------------------------
# 2. Initial data quality checks
# ------------------------------------------------------------

categorical_vars <- c(
  "positive_nodes",
  "stage_of_cancer",
  "chromatin_score",
  "year_of_surgery",
  "relapse"
)

for (var in categorical_vars) {
  print(
    analysis_data %>%
      count(.data[[var]], .drop = FALSE)
  )
}

numeric_vars <- c(
  "positive_nodes",
  "protein_marker",
  "ageatsurgery",
  "chromatin_score",
  "year_of_surgery"
)

analysis_data %>%
  summarise(
    across(
      all_of(numeric_vars),
      list(
        n = ~sum(!is.na(.)),
        missing = ~sum(is.na(.)),
        mean = ~mean(., na.rm = TRUE),
        sd = ~sd(., na.rm = TRUE),
        min = ~min(., na.rm = TRUE),
        q1 = ~quantile(., 0.25, na.rm = TRUE),
        median = ~median(., na.rm = TRUE),
        q3 = ~quantile(., 0.75, na.rm = TRUE),
        max = ~max(., na.rm = TRUE)
      )
    )
  )

# ------------------------------------------------------------
# 3. Identify potentially implausible values
# ------------------------------------------------------------

analysis_data %>%
  filter(
    ageatsurgery > 100 |
      year_of_surgery < 2000
  )

# ------------------------------------------------------------
# 4. Correct confirmed data-entry errors
# ------------------------------------------------------------

analysis_data <- analysis_data %>%
  mutate(
    ageatsurgery = if_else(
      ageatsurgery == 158,
      58,
      ageatsurgery
    ),
    year_of_surgery = if_else(
      year_of_surgery == 1960,
      2016,
      year_of_surgery
    )
  )

# Verify corrections
analysis_data %>%
  summarise(
    across(
      c(ageatsurgery, year_of_surgery, chromatin_score),
      list(
        n = ~sum(!is.na(.)),
        missing = ~sum(is.na(.)),
        min = ~min(., na.rm = TRUE),
        max = ~max(., na.rm = TRUE)
      )
    )
  )

# Confirm implausible values are no longer present
analysis_data %>%
  filter(
    ageatsurgery > 100 |
      year_of_surgery < 2000
  )

# ------------------------------------------------------------
# 5. Create analytic variables
# ------------------------------------------------------------

analysis_data <- analysis_data %>%
  mutate(
    node_positive = case_when(
      is.na(positive_nodes) ~ NA_real_,
      positive_nodes > 0 ~ 1,
      TRUE ~ 0
    ),

    chrom_missing = if_else(
      is.na(chromatin_score),
      1,
      0
    )
  )

# ------------------------------------------------------------
# 6. Descriptive statistics
# ------------------------------------------------------------

analysis_data %>%
  count(relapse, .drop = FALSE)

analysis_data %>%
  count(positive_nodes, .drop = FALSE)

analysis_data %>%
  count(node_positive, .drop = FALSE)

# Positive lymph nodes by relapse
table(
  analysis_data$positive_nodes,
  analysis_data$relapse,
  useNA = "ifany"
)

# Binary lymph-node status by relapse
node_relapse_table <- table(
  analysis_data$node_positive,
  analysis_data$relapse
)

node_relapse_table
chisq.test(node_relapse_table)

# ------------------------------------------------------------
# 7. Assess chromatin-score missingness
# ------------------------------------------------------------

chrom_relapse_table <- table(
  analysis_data$chrom_missing,
  analysis_data$relapse
)

chrom_relapse_table
chisq.test(chrom_relapse_table)

chrom_node_table <- table(
  analysis_data$chrom_missing,
  analysis_data$node_positive
)

chrom_node_table
chisq.test(chrom_node_table)

year_missing_table <- table(
  analysis_data$year_of_surgery,
  analysis_data$chrom_missing
)

year_missing_table
chisq.test(year_missing_table)

stage_missing_table <- table(
  analysis_data$stage_of_cancer,
  analysis_data$chrom_missing
)

stage_missing_table
chisq.test(stage_missing_table)

# Compare continuous variables by chromatin-score missingness
analysis_data %>%
  group_by(chrom_missing) %>%
  summarise(
    across(
      c(ageatsurgery, protein_marker, positive_nodes),
      list(
        n = ~sum(!is.na(.)),
        mean = ~mean(., na.rm = TRUE),
        sd = ~sd(., na.rm = TRUE),
        median = ~median(., na.rm = TRUE),
        min = ~min(., na.rm = TRUE),
        max = ~max(., na.rm = TRUE)
      )
    ),
    .groups = "drop"
  )

# ------------------------------------------------------------
# 8. Examine cancer stage, relapse, and lymph-node status
# ------------------------------------------------------------

stage_relapse_table <- table(
  analysis_data$stage_of_cancer,
  analysis_data$relapse
)

stage_relapse_table
chisq.test(stage_relapse_table)

stage_node_table <- table(
  analysis_data$stage_of_cancer,
  analysis_data$node_positive
)

stage_node_table
chisq.test(stage_node_table)

# ------------------------------------------------------------
# 9. Create positive lymph-node categories
# ------------------------------------------------------------

analysis_data <- analysis_data %>%
  mutate(
    node_group = case_when(
      is.na(positive_nodes) ~ NA_character_,
      positive_nodes == 0 ~ "0",
      positive_nodes == 1 ~ "1",
      positive_nodes >= 2 ~ "2 or more"
    ),

    node_group = factor(
      node_group,
      levels = c("0", "1", "2 or more")
    )
  )

node_group_relapse <- table(
  analysis_data$node_group,
  analysis_data$relapse
)

node_group_relapse
chisq.test(node_group_relapse)

# ------------------------------------------------------------
# 10. Recode cancer stage and transform protein marker
# ------------------------------------------------------------

analysis_data <- analysis_data %>%
  mutate(
    stage_group = case_when(
      stage_of_cancer %in% c("PT0", "PT1", "PT2") ~ "PT0-PT2",
      TRUE ~ as.character(stage_of_cancer)
    ),

    log_protein = log(protein_marker + 1)
  )

# Verify stage grouping
table(
  analysis_data$stage_group,
  analysis_data$relapse,
  useNA = "ifany"
)

# ------------------------------------------------------------
# 11. Unadjusted logistic regression
# ------------------------------------------------------------

analysis_data$node_group <- relevel(
  analysis_data$node_group,
  ref = "0"
)

unadjusted_model <- glm(
  relapse ~ node_group,
  data = analysis_data,
  family = binomial(link = "logit")
)

summary(unadjusted_model)

unadjusted_results <- tidy(
  unadjusted_model,
  exponentiate = TRUE,
  conf.int = TRUE
)

unadjusted_results

# ------------------------------------------------------------
# 12. Adjusted logistic regression
# ------------------------------------------------------------

analysis_data$stage_group <- factor(
  analysis_data$stage_group
)

analysis_data$stage_group <- relevel(
  analysis_data$stage_group,
  ref = "PT2A"
)

adjusted_model <- glm(
  relapse ~
    node_group +
    stage_group +
    ageatsurgery +
    log_protein +
    year_of_surgery,
  data = analysis_data,
  family = binomial(link = "logit")
)

summary(adjusted_model)

adjusted_results <- tidy(
  adjusted_model,
  exponentiate = TRUE,
  conf.int = TRUE
)

adjusted_results

# ------------------------------------------------------------
# 13. Chromatin-score sensitivity analysis
# ------------------------------------------------------------

chromatin_relapse_table <- table(
  analysis_data$chromatin_score,
  analysis_data$relapse
)

chromatin_relapse_table
chisq.test(chromatin_relapse_table)

chromatin_model <- glm(
  relapse ~
    node_group +
    stage_group +
    ageatsurgery +
    log_protein +
    year_of_surgery +
    chromatin_score,
  data = analysis_data,
  family = binomial(link = "logit")
)

chromatin_results <- tidy(
  chromatin_model,
  exponentiate = TRUE,
  conf.int = TRUE
)

chromatin_results

# ------------------------------------------------------------
# 14. Complete-case sensitivity model
# ------------------------------------------------------------

complete_chromatin <- analysis_data %>%
  filter(!is.na(chromatin_score))

sensitivity_model <- glm(
  relapse ~
    node_group +
    stage_group +
    ageatsurgery +
    log_protein +
    year_of_surgery,
  data = complete_chromatin,
  family = binomial(link = "logit")
)

sensitivity_results <- tidy(
  sensitivity_model,
  exponentiate = TRUE,
  conf.int = TRUE
)

sensitivity_results

# ------------------------------------------------------------
# 15. Relapse percentages and 95% confidence intervals
# ------------------------------------------------------------

relapse_summary <- analysis_data %>%
  filter(
    !is.na(node_group),
    !is.na(relapse)
  ) %>%
  group_by(node_group) %>%
  summarise(
    n = n(),
    relapse_cases = sum(relapse == 1),
    relapse_percent = 100 * mean(relapse == 1),
    .groups = "drop"
  )

relapse_summary

# Exact binomial confidence intervals
relapse_ci <- analysis_data %>%
  filter(
    !is.na(node_group),
    !is.na(relapse)
  ) %>%
  group_by(node_group) %>%
  summarise(
    n = n(),
    relapse_cases = sum(relapse == 1),
    relapse_percent = 100 * relapse_cases / n,

    lower_ci = 100 * binom.test(
      relapse_cases,
      n
    )$conf.int[1],

    upper_ci = 100 * binom.test(
      relapse_cases,
      n
    )$conf.int[2],

    .groups = "drop"
  )

relapse_ci
